secondary"><span data-cds="Icon" class="transition-transform duration-fast motion-reduce:transition-none -rotate-90 page-rtl:rotate-90" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3; width: 0.6em; height: 0.6em; contain: layout paint; pointer-events: none; translate: 0px 0.5px;"></span></span></button></div><span class="sr-only" role="status" aria-live="polite"></span></div><div data-transcript-engine-root="" class="contents"><div data-cds="Prose" data-prose-heading-size="sm" data-prose-tables="flat" class="prose stacks:[&amp;_li:not(:where([data-cds-theme]_*:not([data-cds-unthemed]_*)))::marker]:[--cds-text-secondary:currentColor]" style="--_prose-font-body: var(--font-claude-response, var(--cds-font-voice)); --_prose-font-heading-display: var(--_prose-font-heading);"><div data-perf-reply-text="" class="_blocks_ta2es_47 standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 whitespace-normal break-words print:block"><h2 dir="ltr" aria-level="4">Adding the Python code for Phase 4, step 2</h2>
<p dir="ltr">This step needs two small scripts. They live in your repo root, next to <code dir="ltr">load_raw.py</code>. They aren’t part of dbt. They just edit the raw data so you can watch the incremental model react.</p>
<h3 dir="ltr" aria-level="5">Before you start</h3>
<ol dir="ltr">
<li>Build <code dir="ltr">fct_orders</code> once so it exists. From inside <code dir="ltr">olist/</code>:</li>
</ol>
<div data-not-prose=""><div role="group" aria-label="powershell code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_305_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">powershell</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-powershell" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span>dbt run --select fct_orders</span></span></span></code></pre></div></div></div>
<ol dir="ltr" start="2">
<li>Make sure nothing else has the database open (the DuckDB CLI, another Python session). dbt must not be running either.</li>
</ol>
<h3 dir="ltr" aria-level="5">Step A: Create <code dir="ltr">update_order.py</code></h3>
<p dir="ltr">In VS Code (or any editor), create a new file named <code dir="ltr">update_order.py</code> in the repo root, the same folder as <code dir="ltr">load_raw.py</code>, and paste:</p>
<div data-not-prose=""><div role="group" aria-label="python code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_306_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">python</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-python" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(204, 123, 244);">import</span> duckdb
</span><span>
</span><span>con = duckdb<span style="color: rgb(211, 215, 222);">.</span>connect<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"olist/olist.duckdb"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>
</span><span><span style="color: rgb(129, 136, 152);"># Find the most recent order</span>
</span><span>oid<span style="color: rgb(211, 215, 222);">,</span> old_status = con<span style="color: rgb(211, 215, 222);">.</span>execute<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"""</span>
</span><span><span style="color: rgb(155, 233, 99);">    select order_id, order_status</span>
</span><span><span style="color: rgb(155, 233, 99);">    from raw.orders</span>
</span><span><span style="color: rgb(155, 233, 99);">    order by order_purchase_timestamp desc</span>
</span><span><span style="color: rgb(155, 233, 99);">    limit 1</span>
</span><span><span style="color: rgb(155, 233, 99);">"""</span><span style="color: rgb(211, 215, 222);">).</span>fetchone<span style="color: rgb(211, 215, 222);">()</span>
</span><span>
</span><span>new_status = <span style="color: rgb(155, 233, 99);">"canceled"</span><span style="color: rgb(204, 123, 244);"> if</span> old_status != <span style="color: rgb(155, 233, 99);">"canceled"</span><span style="color: rgb(204, 123, 244);"> else</span><span style="color: rgb(155, 233, 99);"> "unavailable"</span>
</span><span>
</span><span>con<span style="color: rgb(211, 215, 222);">.</span>execute<span style="color: rgb(211, 215, 222);">(</span>
</span><span><span style="color: rgb(155, 233, 99);">    "update raw.orders set order_status = ? where order_id = ?"</span><span style="color: rgb(211, 215, 222);">,</span>
</span><span><span style="color: rgb(211, 215, 222);">    [</span>new_status<span style="color: rgb(211, 215, 222);">,</span> oid<span style="color: rgb(211, 215, 222);">],</span>
</span><span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>con<span style="color: rgb(211, 215, 222);">.</span>close<span style="color: rgb(211, 215, 222);">()</span>
</span><span>
</span><span><span style="color: rgb(112, 184, 255);">print</span><span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(204, 123, 244);">f</span><span style="color: rgb(155, 233, 99);">"Order: </span><span style="color: rgb(94, 237, 237);">{</span>oid<span style="color: rgb(94, 237, 237);">}</span><span style="color: rgb(155, 233, 99);">"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span><span style="color: rgb(112, 184, 255);">print</span><span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(204, 123, 244);">f</span><span style="color: rgb(155, 233, 99);">"Status changed: </span><span style="color: rgb(94, 237, 237);">{</span>old_status<span style="color: rgb(94, 237, 237);">}</span><span style="color: rgb(155, 233, 99);"> -&gt; </span><span style="color: rgb(94, 237, 237);">{</span>new_status<span style="color: rgb(94, 237, 237);">}</span><span style="color: rgb(155, 233, 99);">"</span><span style="color: rgb(211, 215, 222);">)</span></span></span></span></code></pre></div></div></div>
<p dir="ltr">Run it from the <strong>repo root</strong> (the folder containing <code dir="ltr">load_raw.py</code>, not <code dir="ltr">olist/</code>):</p>
