</span><span><span style="color: rgb(244, 123, 133);">  outputs</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">    dev</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">      type</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> duckdb</span>
