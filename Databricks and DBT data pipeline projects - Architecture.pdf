 style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="not-print:flow-root not-print:w-max print:!whitespace-pre-wrap pe-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;">databricks-nyc-taxi-lakehouse/
