md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_2pi_" data-base-ui-tooltip-trigger="" fdprocessedid="ae0wt"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!" style="--cds-btn-press-sx: 0.9375; --cds-btn-press-sy: 0.9375;"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">markdown</div><div class="overflow-x-auto print:overflow-x-clip"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5 print:!break-inside-auto print:overflow-clip" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-markdown" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(211, 215, 222);">#</span> Olist E-commerce Analytics Warehouse (dbt + DuckDB)
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">[![</span><span style="color: rgb(155, 233, 99);">dbt-ci</span><span style="color: rgb(211, 215, 222);">](</span><span style="color: rgb(94, 237, 237);">https://github.com/&lt;YOUR-USERNAME&gt;/olist-dbt-warehouse/actions/workflows/dbt-ci.yml/badge.svg</span><span style="color: rgb(211, 215, 222);">)](</span><span style="color: rgb(94, 237, 237);">https://github.com/&lt;YOUR-USERNAME&gt;/olist-dbt-warehouse/actions</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>
</span><span>An ELT project that turns the Olist Brazilian e-commerce dataset (9 raw CSV tables) into a tested star schema with dbt Core and DuckDB, plus a small Streamlit dashboard.
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> What this project demonstrates
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">-</span> Layered dbt project: sources, staging, intermediate, marts
</span><span><span style="color: rgb(211, 215, 222);">-</span> Star schema: 2 fact tables and 4 dimensions, with explicit grain for each
</span><span><span style="color: rgb(211, 215, 222);">-</span> Incremental model with a lookback window for late-arriving updates
</span><span><span style="color: rgb(211, 215, 222);">-</span> SCD Type 2 snapshot on sellers
</span><span><span style="color: rgb(211, 215, 222);">-</span> &lt;N&gt; data tests: generic, custom SQL, and <span style="color: rgb(211, 215, 222);">`</span>dbt_expectations<span style="color: rgb(211, 215, 222);">`</span>
</span><span><span style="color: rgb(211, 215, 222);">-</span> Auto-generated docs and lineage, a dbt exposure, and CI with GitHub Actions
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Architecture
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">```</span>mermaid
</span><span>flowchart LR
</span><span>    A[Olist CSVs] --&gt; B[load_raw.py]
</span><span>    B --&gt; C[(DuckDB: raw schema)]
</span><span>    C --&gt; D[Staging views]
</span><span>    D --&gt; E[Intermediate models]
</span><span>    E --&gt; F[Marts: facts and dimensions]
</span><span>    D --&gt; S[Snapshot: sellers SCD2]
</span><span>    F --&gt; G[Streamlit dashboard]
</span><span><span style="color: rgb(211, 215, 222);">```</span>
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Data model
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">|</span> Model <span style="color: rgb(211, 215, 222);">|</span> Grain (one row per...) <span style="color: rgb(211, 215, 222);">|</span>
</span><span><span style="color: rgb(211, 215, 222);">|---|---|</span>
</span></span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(211, 215, 222);">| `</span>fct_orders<span style="color: rgb(211, 215, 222);">` |</span> order (incremental) <span style="color: rgb(211, 215, 222);">|</span>
</span><span><span style="color: rgb(211, 215, 222);">| `</span>fct_order_items<span style="color: rgb(211, 215, 222);">` |</span> order item <span style="color: rgb(211, 215, 222);">|</span>
</span><span><span style="color: rgb(211, 215, 222);">| `</span>dim_customers<span style="color: rgb(211, 215, 222);">` |</span> unique customer (<span style="color: rgb(211, 215, 222);">`</span>customer_unique_id<span style="color: rgb(211, 215, 222);">`</span>) <span style="color: rgb(211, 215, 222);">|</span>
</span><span><span style="color: rgb(211, 215, 222);">| `</span>dim_sellers<span style="color: rgb(211, 215, 222);">` |</span> seller <span style="color: rgb(211, 215, 222);">|</span>
</span><span><span style="color: rgb(211, 215, 222);">| `</span>dim_products<span style="color: rgb(211, 215, 222);">` |</span> product <span style="color: rgb(211, 215, 222);">|</span>
</span><span><span style="color: rgb(211, 215, 222);">| `</span>dim_date<span style="color: rgb(211, 215, 222);">` |</span> calendar day <span style="color: rgb(211, 215, 222);">|</span>
</span><span>
</span><span>Lineage graph:
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">![</span><span style="color: rgb(155, 233, 99);">Lineage</span><span style="color: rgb(211, 215, 222);">](</span><span style="color: rgb(94, 237, 237);">docs/images/lineage.png</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Tech stack
</span><span>
</span><span>dbt Core, DuckDB (dbt-duckdb adapter), Python, Streamlit, GitHub Actions
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> How to run it
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">1.</span> Clone the repo and create an environment:
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>bash
</span><span>   git clone https://github.com/&lt;YOUR-USERNAME&gt;/olist-dbt-warehouse.git
</span><span>   cd olist-dbt-warehouse
</span><span>   python -m venv .venv
</span><span>   # Windows PowerShell: .venv<span style="color: rgb(94, 237, 237);">\S</span>cripts<span style="color: rgb(94, 237, 237);">\A</span>ctivate.ps1   |   <span style="color: rgb(112, 184, 255);">Mac/Linux:</span><span style="color: rgb(155, 233, 99);"> source .venv/bin/activate</span>
</span><span>   pip install -r requirements.txt
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>
</span><span><span style="color: rgb(211, 215, 222);">2.</span> Download the dataset from Kaggle ("Brazilian E-Commerce Public Dataset by Olist") and unzip the 9 CSVs into a <span style="color: rgb(211, 215, 222);">`</span>data/<span style="color: rgb(211, 215, 222);">`</span> folder. The data is not stored in this repo; check the dataset's license on Kaggle.
</span><span><span style="color: rgb(211, 215, 222);">3.</span> Load the raw tables into DuckDB:
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>bash
</span><span>   python load_raw.py
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>
</span><span><span style="color: rgb(211, 215, 222);">4.</span> Build and test the project:
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>bash
</span></span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span>   cd olist
</span><span>   dbt deps
</span><span>   dbt build
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>
</span><span><span style="color: rgb(211, 215, 222);">5.</span> Generate and view the docs:
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>bash
</span><span>   dbt docs generate
</span><span>   dbt docs serve
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>
</span><span><span style="color: rgb(211, 215, 222);">6.</span> (Optional) Run the dashboard from the repo root:
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>bash
</span><span>   streamlit run app.py
</span><span><span style="color: rgb(211, 215, 222);">   ```</span>
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Testing
</span><span>
</span><span>&lt;N&gt; tests run on every <span style="color: rgb(211, 215, 222);">`</span>dbt build<span style="color: rgb(211, 215, 222);">`</span>:
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">-</span> Generic: <span style="color: rgb(211, 215, 222);">`</span>unique<span style="color: rgb(211, 215, 222);">`</span>, <span style="color: rgb(211, 215, 222);">`</span>not_null<span style="color: rgb(211, 215, 222);">`</span>, <span style="color: rgb(211, 215, 222);">`</span>relationships<span style="color: rgb(211, 215, 222);">`</span>, <span style="color: rgb(211, 215, 222);">`</span>accepted_values<span style="color: rgb(211, 215, 222);">`</span>
</span><span><span style="color: rgb(211, 215, 222);">-</span> Custom SQL tests: delivery date after purchase date, non-negative payments, no orphan order items
</span><span><span style="color: rgb(211, 215, 222);">- `</span>dbt_expectations<span style="color: rgb(211, 215, 222);">`</span>: row-count bounds, value ranges
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Design decisions
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Customer grain:<span style="color: rgb(211, 215, 222);">** `</span>customer_id<span style="color: rgb(211, 215, 222);">`</span> in the raw data is generated per order, so the customer dimension uses <span style="color: rgb(211, 215, 222);">`</span>customer_unique_id<span style="color: rgb(211, 215, 222);">`</span>. Repeat-purchase analysis depends on this.
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Staging has no joins:<span style="color: rgb(211, 215, 222);">**</span> staging models only rename, cast, and select. Joins and business logic start in the intermediate layer.
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Incremental strategy:<span style="color: rgb(211, 215, 222);">** `</span>fct_orders<span style="color: rgb(211, 215, 222);">`</span> uses <span style="color: rgb(211, 215, 222);">`</span>delete+insert<span style="color: rgb(211, 215, 222);">`</span> with <span style="color: rgb(211, 215, 222);">`</span>unique_key='order_id'<span style="color: rgb(211, 215, 222);">`</span>. Each run reprocesses the last 30 days of orders because an order's status can change after purchase.
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Incremental proof:<span style="color: rgb(211, 215, 222);">**</span> I changed one raw order's status and re-ran only <span style="color: rgb(211, 215, 222);">`</span>fct_orders<span style="color: rgb(211, 215, 222);">`</span>; the fact row updated without a full rebuild. &lt;insert before/after screenshot&gt;
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Snapshot:<span style="color: rgb(211, 215, 222);">** `</span>snap_sellers<span style="color: rgb(211, 215, 222);">`</span> tracks changes to seller city and state. &lt;insert screenshot of two history rows&gt;
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Geolocation table skipped:<span style="color: rgb(211, 215, 222);">**</span> it has about 1M rows with many duplicates per zip prefix, and no mart needs it.
</span><span><span style="color: rgb(211, 215, 222);">- **</span>Package choice:<span style="color: rgb(211, 215, 222);">** `</span>metaplane/dbt_expectations<span style="color: rgb(211, 215, 222);">`</span>, the fork listed as compatible with newer dbt versions.
</span><span><span style="color: rgb(211, 215, 222);">- **</span>CI scope:<span style="color: rgb(211, 215, 222);">**</span> &lt;describe what yours does: full build with Kaggle download, or parse-only&gt;. Next step would be slim CI using <span style="color: rgb(211, 215, 222);">`</span>state:modified+<span style="color: rgb(211, 215, 222);">`</span> with a stored manifest.
</span></span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Data findings
</span><span>
</span><span>&lt;List real issues your tests found and what you did about each. Examples of the format:&gt;
</span><span><span style="color: rgb(211, 215, 222);">-</span> &lt;Test name&gt; failed on &lt;N&gt; rows because &lt;reason&gt;; resolved by &lt;fix or severity: warn&gt;.
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Dashboard
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">![</span><span style="color: rgb(155, 233, 99);">Dashboard</span><span style="color: rgb(211, 215, 222);">](</span><span style="color: rgb(94, 237, 237);">docs/images/dashboard.png</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>
</span><span>Metrics: monthly revenue, late-delivery rate by seller (sellers with 30+ orders), repeat purchase rate.
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Possible next steps
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">-</span> dbt Semantic Layer / MetricFlow metrics
</span><span><span style="color: rgb(211, 215, 222);">-</span> Publish docs on GitHub Pages
</span><span><span style="color: rgb(211, 215, 222);">-</span> Slim CI and a production target (BigQuery or Snowflake)
</span><span><span style="color: rgb(211, 215, 222);">-</span> Orchestration with Dagster or Airflow
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">##</span> Data source
</span><span>
</span><span>Brazilian E-Commerce Public Dataset by Olist, on Kaggle. Not redistributed here.</span></span></span></code></pre></div></div></div>
