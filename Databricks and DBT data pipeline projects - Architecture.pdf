length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-sql" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(204, 123, 244);">select</span>
</span><span>    {{ dbt_utils.generate_surrogate_key(['order_id', 'order_item_id']) }} <span style="color: rgb(204, 123, 244);">as</span> order_item_key,
</span><span>    order_id,
</span><span>    order_item_id,
</span><span>    {{ dbt_utils.generate_surrogate_key(['product_id']) }} <span style="color: rgb(204, 123, 244);">as</span> product_key,
</span><span>    {{ dbt_utils.generate_surrogate_key(['seller_id']) }}  <span style="color: rgb(204, 123, 244);">as</span> seller_key,
</span><span><span style="color: rgb(112, 184, 255);">    cast</span>(purchased_at <span style="color: rgb(204, 123, 244);">as date</span>) <span style="color: rgb(204, 123, 244);">as</span> purchase_date_key,
</span><span>    order_status,
</span><span>    category_name,
</span><span>    price,
</span><span>    freight_value,
</span><span>    price + freight_value <span style="color: rgb(204, 123, 244);">as</span> item_total
</span><span><span style="color: rgb(204, 123, 244);">from</span> {{ ref(<span style="color: rgb(155, 233, 99);">'int_order_items_enriched'</span>) }}</span></span></span></code></pre></div></div></div>
<p dir="ltr">The fact table’s <code dir="ltr">product_key</code> and <code dir="ltr">seller_key</code> are generated from the same source column and the same function as in the dimensions, so they match. That is what makes the <code dir="ltr">relationships</code> tests pass later.</p>
