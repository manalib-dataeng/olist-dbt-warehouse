length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-sql" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(204, 123, 244);">select</span>
</span><span>    {{ dbt_utils.generate_surrogate_key(['customer_unique_id']) }} <span style="color: rgb(204, 123, 244);">as</span> customer_key,
</span><span>    customer_unique_id,
</span><span>    any_value(customer_city)  <span style="color: rgb(204, 123, 244);">as</span> city,
</span><span>    any_value(customer_state) <span style="color: rgb(204, 123, 244);">as state</span>
</span><span><span style="color: rgb(204, 123, 244);">from</span> {{ ref(<span style="color: rgb(155, 233, 99);">'stg_customers'</span>) }}
</span><span><span style="color: rgb(204, 123, 244);">group by</span> customer_unique_id</span></span></span></code></pre></div></div></div>
<p dir="ltr">Build <code dir="ltr">dim_sellers</code> (surrogate key on <code dir="ltr">seller_id</code>, plus city and state) and <code dir="ltr">dim_products</code> (surrogate key on <code dir="ltr">product_id</code>, category name, weights) the same way.</p>
