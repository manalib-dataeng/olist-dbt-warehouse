</span><span>
</span><span><span style="color: rgb(244, 123, 133);">sources</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(211, 215, 222);">  -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> raw</span>
</span><span><span style="color: rgb(244, 123, 133);">    schema</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> raw</span>
</span><span><span style="color: rgb(244, 123, 133);">    loaded_at_field</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> _loaded_at</span>
</span><span><span style="color: rgb(244, 123, 133);">    freshness</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">      warn_after</span><span style="color: rgb(211, 215, 222);">: {</span><span style="color: rgb(244, 123, 133);">count</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(94, 237, 237);"> 24</span><span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(244, 123, 133);"> period</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> hour</span><span style="color: rgb(211, 215, 222);">}</span>
</span><span><span style="color: rgb(244, 123, 133);">    tables</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> orders</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> customers</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> order_items</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> order_payments</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> order_reviews</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> products</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> sellers</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> product_category_name_translation</span></span></span></span></code></pre></div></div></div>
<p dir="ltr">Newer dbt versions may warn that <code dir="ltr">freshness</code> belongs under <code dir="ltr">config:</code>. Follow the warning if you see it. Then run <code dir="ltr">dbt source freshness</code>.</p>
<ol dir="ltr" start="3">
<li>Create these models in <code dir="ltr">olist/models/staging/</code>. Start with two to learn the pattern.</li>
</ol>
