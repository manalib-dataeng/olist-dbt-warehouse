    create temporary table
      "snap_sellers__dbt_tmp20261119145904294944"
  
    
    as (
      
    
    with snapshot_query as (

        

select * from "olist"."main"."stg_sellers"

    ),

    snapshotted_data as (

        select *, 
    
        seller_id as dbt_unique_key
    

        from "olist"."snapshots"."snap_sellers"
        where
            
                dbt_valid_to is null
            

    ),

    insertions_source_data as (

        select *, 
    
        seller_id as dbt_unique_key
    
,
            now()::timestamp as dbt_updated_at,
            now()::timestamp as dbt_valid_from,
            
  
  coalesce(nullif(now()::timestamp, now()::timestamp), null)
  as dbt_valid_to
,
            md5(coalesce(cast(seller_id as varchar ), '')
         || '|' || coalesce(cast(now()::timestamp as varchar ), '')
        ) as dbt_scd_id

        from snapshot_query
    ),

    updates_source_data as (

        select *, 
    
        seller_id as dbt_unique_key
    
,
            now()::timestamp as dbt_updated_at,
            now()::timestamp as dbt_valid_from,
            now()::timestamp as dbt_valid_to

        from snapshot_query
    ),

    insertions as (

        select
            'insert' as dbt_change_type,
            source_data.*

        from insertions_source_data as source_data
        left outer join snapshotted_data
            on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

            where 
    
        snapshotted_data.dbt_unique_key is null
    

            or (
    
        snapshotted_data.dbt_unique_key is not null
    
 and (
               (snapshotted_data."seller_city" != source_data."seller_city"
        or
        (
            ((snapshotted_data."seller_city" is null) and not (source_data."seller_city" is null))
            or
            ((not snapshotted_data."seller_city" is null) and (source_data."seller_city" is null))
        ) or snapshotted_data."seller_state" != source_data."seller_state"
        or
        (
            ((snapshotted_data."seller_state" is null) and not (source_data."seller_state" is null))
            or
            ((not snapshotted_data."seller_state" is null) and (source_data."seller_state" is null))
        ))
            )

        )

    ),

    updates as (

        select
            'update' as dbt_change_type,
            source_data.*,
            snapshotted_data.dbt_scd_id

        from updates_source_data as source_data
        join snapshotted_data
            on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

        where (
            (snapshotted_data."seller_city" != source_data."seller_city"
        or
        (
            ((snapshotted_data."seller_city" is null) and not (source_data."seller_city" is null))
            or
            ((not snapshotted_data."seller_city" is null) and (source_data."seller_city" is null))
        ) or snapshotted_data."seller_state" != source_data."seller_state"
        or
        (
            ((snapshotted_data."seller_state" is null) and not (source_data."seller_state" is null))
            or
            ((not snapshotted_data."seller_state" is null) and (source_data."seller_state" is null))
        ))
        )
    )

    select * from insertions
    union all
