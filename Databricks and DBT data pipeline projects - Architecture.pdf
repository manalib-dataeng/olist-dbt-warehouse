length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-sql" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(204, 123, 244);">select</span> oi.order_item_key
</span><span><span style="color: rgb(204, 123, 244);">from</span> {{ ref(<span style="color: rgb(155, 233, 99);">'fct_order_items'</span>) }} oi
</span><span><span style="color: rgb(204, 123, 244);">left join</span> {{ ref(<span style="color: rgb(155, 233, 99);">'fct_orders'</span>) }} o <span style="color: rgb(204, 123, 244);">using</span> (order_id)
</span><span><span style="color: rgb(204, 123, 244);">where</span> o.order_id <span style="color: rgb(204, 123, 244);">is null</span></span></span></span></code></pre></div></div></div>
<ol dir="ltr" start="3">
<li>Run <code dir="ltr">dbt build</code>. Some tests may fail on real data. That’s normal and good: investigate each, then either fix the model, loosen the test with a documented reason, or set <code dir="ltr">severity: warn</code>. Document these in your README, as hiring managers love seeing real data issues you found.</li>
<li>Run <code dir="ltr">dbt docs generate</code> then <code dir="ltr">dbt docs serve</code>. Open the lineage graph (blue circle, bottom right) and screenshot it.</li>
</ol>
<p dir="ltr"><strong>Done when:</strong> <code dir="ltr">dbt build</code> is green (or failures are explained) with 30+ tests.</p>
<h3 dir="ltr" aria-level="5">Phase 6: CI with GitHub Actions (45 min)</h3>
<p dir="ltr">Create <code dir="ltr">.github/workflows/dbt-ci.yml</code>:</p>
<div data-not-prose=""><div role="group" aria-label="yaml code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_334_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">yaml</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-yaml" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(244, 123, 133);">name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> dbt-ci</span>
</span><span><span style="color: rgb(94, 237, 237);">on</span><span style="color: rgb(211, 215, 222);">: [</span><span style="color: rgb(155, 233, 99);">push</span><span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(155, 233, 99);"> pull_request</span><span style="color: rgb(211, 215, 222);">]</span>
</span><span>
</span><span><span style="color: rgb(244, 123, 133);">jobs</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">  build</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">    runs-on</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> ubuntu-latest</span>
</span><span><span style="color: rgb(244, 123, 133);">    steps</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> uses</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> actions/checkout@v4</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> uses</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> actions/setup-python@v5</span>
</span><span><span style="color: rgb(244, 123, 133);">        with</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">          python-version</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> "3.11"</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> run</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> pip install dbt-core dbt-duckdb duckdb kaggle</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> Download Olist data</span>
</span><span><span style="color: rgb(244, 123, 133);">        env</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">          KAGGLE_USERNAME</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> ${{ secrets.KAGGLE_USERNAME }}</span>
</span><span><span style="color: rgb(244, 123, 133);">          KAGGLE_KEY</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> ${{ secrets.KAGGLE_KEY }}</span>
</span><span><span style="color: rgb(244, 123, 133);">        run</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> kaggle datasets download -d olistbr/brazilian-ecommerce -p data --unzip</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> run</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> python load_raw.py</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> dbt build</span>
</span><span><span style="color: rgb(244, 123, 133);">        working-directory</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> olist</span>
</span><span><span style="color: rgb(244, 123, 133);">        run</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(204, 123, 244);"> |</span>
</span><span><span style="color: rgb(155, 233, 99);">          dbt deps</span>
</span><span><span style="color: rgb(155, 233, 99);">          dbt build</span></span></span></span></code></pre></div></div></div>
<p dir="ltr">Add <code dir="ltr">KAGGLE_USERNAME</code> and <code dir="ltr">KAGGLE_KEY</code> under the repo’s Settings → Secrets and variables → Actions. Kaggle’s API authentication has been changing, so check their current docs if the download step fails.</p>
<p dir="ltr"><strong>Fallback if the Kaggle step is a hassle:</strong> replace the download and load steps with just <code dir="ltr">dbt deps</code> and <code dir="ltr">dbt parse</code>. That only checks that the project compiles, which is weaker, so say so in the README. Mention “slim CI” (<code dir="ltr">state:modified+</code>, which needs a stored manifest) as a next step.</p>
<h3 dir="ltr" aria-level="5">Phase 7: Dashboard and exposure (1 hr)</h3>
<p dir="ltr">Run these three queries in the DuckDB CLI or Python and screenshot the results. A Streamlit app is optional.</p>
<div data-not-prose=""><div role="group" aria-label="sql code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_335_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">sql</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-sql" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(129, 136, 152);">-- 1. Monthly revenue</span>
</span><span><span style="color: rgb(204, 123, 244);">select</span> d.year_month, <span style="color: rgb(112, 184, 255);">round</span>(<span style="color: rgb(112, 184, 255);">sum</span>(oi.price), <span style="color: rgb(94, 237, 237);">2</span>) <span style="color: rgb(204, 123, 244);">as</span> revenue
</span><span><span style="color: rgb(204, 123, 244);">from</span> fct_order_items oi
</span><span><span style="color: rgb(204, 123, 244);">join</span> dim_date d <span style="color: rgb(204, 123, 244);">on</span> oi.purchase_date_key = d.date_key
</span><span><span style="color: rgb(204, 123, 244);">group by</span><span style="color: rgb(94, 237, 237);"> 1</span><span style="color: rgb(204, 123, 244);"> order by</span><span style="color: rgb(94, 237, 237);"> 1</span>;
</span><span>
</span><span><span style="color: rgb(129, 136, 152);">-- 2. Late delivery rate by seller (sellers with 30+ orders)</span>
</span><span><span style="color: rgb(204, 123, 244);">select</span> s.seller_id,
</span><span><span style="color: rgb(112, 184, 255);">       count</span>(<span style="color: rgb(204, 123, 244);">distinct</span> oi.order_id) <span style="color: rgb(204, 123, 244);">as</span> orders,
</span><span><span style="color: rgb(112, 184, 255);">       round</span>(<span style="color: rgb(112, 184, 255);">count</span>(<span style="color: rgb(204, 123, 244);">distinct case when</span> o.is_late = <span style="color: rgb(94, 237, 237);">1</span><span style="color: rgb(204, 123, 244);"> then</span> oi.order_id <span style="color: rgb(204, 123, 244);">end</span>) * <span style="color: rgb(94, 237, 237);">1</span>.<span style="color: rgb(94, 237, 237);">0</span>
</span><span>             / <span style="color: rgb(112, 184, 255);">count</span>(<span style="color: rgb(204, 123, 244);">distinct</span> oi.order_id), <span style="color: rgb(94, 237, 237);">3</span>) <span style="color: rgb(204, 123, 244);">as</span> late_rate
</span><span><span style="color: rgb(204, 123, 244);">from</span> fct_order_items oi
</span><span><span style="color: rgb(204, 123, 244);">join</span> fct_orders o <span style="color: rgb(204, 123, 244);">using</span> (order_id)
</span><span><span style="color: rgb(204, 123, 244);">join</span> dim_sellers s <span style="color: rgb(204, 123, 244);">using</span> (seller_key)
</span><span><span style="color: rgb(204, 123, 244);">where</span> o.is_late <span style="color: rgb(204, 123, 244);">is not null</span>
</span><span><span style="color: rgb(204, 123, 244);">group by</span><span style="color: rgb(94, 237, 237);"> 1</span>
</span><span><span style="color: rgb(204, 123, 244);">having</span><span style="color: rgb(112, 184, 255);"> count</span>(<span style="color: rgb(204, 123, 244);">distinct</span> oi.order_id) &gt;= <span style="color: rgb(94, 237, 237);">30</span>
</span><span><span style="color: rgb(204, 123, 244);">order by</span> late_rate <span style="color: rgb(204, 123, 244);">desc limit</span><span style="color: rgb(94, 237, 237);"> 20</span>;
</span><span>
</span><span><span style="color: rgb(129, 136, 152);">-- 3. Repeat purchase rate</span>
</span><span><span style="color: rgb(204, 123, 244);">with</span> c <span style="color: rgb(204, 123, 244);">as</span> (
</span><span><span style="color: rgb(204, 123, 244);">    select</span> customer_key, <span style="color: rgb(112, 184, 255);">count</span>(*) <span style="color: rgb(204, 123, 244);">as</span> n
</span><span><span style="color: rgb(204, 123, 244);">    from</span> fct_orders <span style="color: rgb(204, 123, 244);">where</span> order_status = <span style="color: rgb(155, 233, 99);">'delivered'</span>
</span><span><span style="color: rgb(204, 123, 244);">    group by</span><span style="color: rgb(94, 237, 237);"> 1</span>
</span><span>)
</span><span><span style="color: rgb(204, 123, 244);">select</span><span style="color: rgb(112, 184, 255);"> round</span>(<span style="color: rgb(112, 184, 255);">avg</span>(<span style="color: rgb(204, 123, 244);">case when</span> n &gt; <span style="color: rgb(94, 237, 237);">1</span><span style="color: rgb(204, 123, 244);"> then</span><span style="color: rgb(94, 237, 237);"> 1</span>.<span style="color: rgb(94, 237, 237);">0</span><span style="color: rgb(204, 123, 244);"> else</span><span style="color: rgb(94, 237, 237);"> 0</span><span style="color: rgb(204, 123, 244);"> end</span>), <span style="color: rgb(94, 237, 237);">4</span>) <span style="color: rgb(204, 123, 244);">as</span> repeat_rate <span style="color: rgb(204, 123, 244);">from</span> c;</span></span></span></code></pre></div></div></div>
<p dir="ltr">Expect a low single-digit percentage for the repeat rate. If you see something much higher, you probably joined on <code dir="ltr">customer_id</code> instead of <code dir="ltr">customer_unique_id</code>.</p>
<p dir="ltr">Optional Streamlit: <code dir="ltr">pip install streamlit</code>, then a small <code dir="ltr">app.py</code> that opens <code dir="ltr">duckdb.connect("olist/olist.duckdb", read_only=True)</code>, runs each query with <code dir="ltr">.df()</code>, and displays them with <code dir="ltr">st.line_chart</code> and <code dir="ltr">st.dataframe</code>. Run with <code dir="ltr">streamlit run app.py</code>.</p>
<p dir="ltr">Add <code dir="ltr">olist/models/exposures.yml</code>:</p>
<div data-not-prose=""><div role="group" aria-label="yaml code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_336_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">yaml</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-yaml" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(244, 123, 133);">version</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(94, 237, 237);"> 2</span>
</span><span>
</span><span><span style="color: rgb(244, 123, 133);">exposures</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(211, 215, 222);">  -</span><span style="color: rgb(244, 123, 133);"> name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> olist_dashboard</span>
</span><span><span style="color: rgb(244, 123, 133);">    type</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> dashboard</span>
</span><span><span style="color: rgb(244, 123, 133);">    maturity</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> low</span>
</span><span><span style="color: rgb(244, 123, 133);">    description</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> "Monthly revenue, seller late-delivery rate, repeat purchase rate."</span>
</span><span><span style="color: rgb(244, 123, 133);">    owner</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(244, 123, 133);">      name</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(155, 233, 99);"> Your Name</span>
</span><span><span style="color: rgb(244, 123, 133);">    depends_on</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(155, 233, 99);"> ref('fct_orders')</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(155, 233, 99);"> ref('fct_order_items')</span>
</span><span><span style="color: rgb(211, 215, 222);">      -</span><span style="color: rgb(155, 233, 99);"> ref('dim_sellers')</span></span></span></span></code></pre></div></div></div>
<p dir="ltr">Re-run <code dir="ltr">dbt docs generate</code>. The exposure now appears at the end of your lineage graph.</p>
<h3 dir="ltr" aria-level="5">Phase 8: Package for GitHub (1 hr)</h3>
<ul dir="ltr">
<li>README with a Mermaid architecture diagram (raw → staging → intermediate → marts → dashboard), setup steps, and screenshots: lineage graph, passing <code dir="ltr">dbt build</code>, snapshot history, incremental demo, dashboard.</li>
<li><strong>Design decisions section:</strong> why <code dir="ltr">customer_unique_id</code> is the customer grain, why staging has no joins, the 30-day lookback for late updates, which tests failed on real data and what you did, and why CI uses what it uses.</li>
<li>Use real numbers in your resume bullets. Count your tests and row counts from your actual run.</li>
</ul>
<p dir="ltr"><strong>Cut if short on time:</strong> Streamlit, GitHub Pages docs, the Kaggle-download CI step (use <code dir="ltr">dbt parse</code>), the exposure, <code dir="ltr">dbt_expectations</code>.</p>
<hr>
<h3 dir="ltr" aria-level="5">Reference videos and guides</h3>
<p dir="ltr">I didn’t find a video of this exact Olist + DuckDB build. These are the closest:</p>
<ol dir="ltr">
<li><strong>dbt’s official DuckDB quickstart.</strong> It walks through installing dbt Core and DuckDB in a virtual environment, then building, testing, and documenting a sample project. Start here: <a class="underline [&amp;:where(:dir(rtl))]:after:content-['\200E']" href="https://docs.getdbt.com/guides/duckdb">https://docs.getdbt.com/guides/duckdb</a> <span data-not-prose=""><span class="inline-flex" id="base-ui-_r_33a_"><a href="https://docs.getdbt.com/guides/duckdb.md" target="_blank" rel="noopener noreferrer" class="group/tag relative h-[18px] rounded-full inline-flex items-center overflow-hidden -translate-y-px cursor-pointer"><span class="relative transition-colors h-full max-w-[180px] overflow-hidden px-1.5 inline-flex items-center text-caption-regular font-sans rounded-full border-0.5 border-border-300 bg-bg-200 group-hover/tag:bg-accent-900 group-hover/tag:border-accent-100/60 stacks:group-hover/tag:bg-page stacks:group-hover/tag:layers-1-accent stacks:group-hover/tag:border-transparent"><span dir="auto" class="text-nowrap text-text-300 font-normal group-hover/tag:text-text-200 break-all truncate">getdbt</span></span><span class="transition-opacity opacity-[0%] group-hover/tag:opacity-[100%] h-[17px] absolute right-[0.5px] rounded-r-full flex items-center px-1.5 bg-gradient-to-r from-accent-900/0 via-accent-900/100 via-30% to-accent-900/100 [&amp;:where(:root[dir=rtl]_:dir(rtl))]:right-auto [&amp;:where(:root[dir=rtl]_:dir(rtl))]:left-[0.5px] [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-r-none [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-l-full [&amp;:where(:root[dir=rtl]_:dir(rtl))]:bg-gradient-to-l stacks:bg-page stacks:layers-1-accent stacks:[mask-image:linear-gradient(to_right,transparent,black_30%)] stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:layers-1-accent stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:[mask-image:linear-gradient(to_left,transparent,black_30%)]"><span data-cds="Icon" data-cds-mirror="" class="transition-[opacity,scale,transform] group-hover/tag:ease-out duration-[500ms] ease-in text-accent-100 group-hover/tag:scale-[100%] scale-[80%] group-hover/tag:opacity-[100%] opacity-[0%]" aria-hidden="true" style="font-size: calc(1rem * var(--cds-rem-scale, 1)); font-weight: 533.3;"></span></span></a></span></span></li>
<li><strong>“DuckDB &amp; dbt | End-To-End Data Engineering Project (2/3)”</strong> (Mehdi Ouazza, MotherDuck on YouTube). It starts a dbt project from scratch with the dbt-duckdb adapter and includes unit tests with mocked source data. It uses S3 and MotherDuck, which you can ignore, but the dbt-with-DuckDB workflow transfers. Page: <a class="underline [&amp;:where(:dir(rtl))]:after:content-['\200E']" href="https://motherduck.com/videos/duckdb-dbt-end-to-end-data-engineering-project-23/">https://motherduck.com/videos/duckdb-dbt-end-to-end-data-engineering-project-23/</a> <span data-not-prose=""><span class="inline-flex" id="base-ui-_r_33e_"><a href="https://motherduck.com/videos/duckdb-dbt-end-to-end-data-engineering-project-23.md" target="_blank" rel="noopener noreferrer" class="group/tag relative h-[18px] rounded-full inline-flex items-center overflow-hidden -translate-y-px cursor-pointer"><span class="relative transition-colors h-full max-w-[180px] overflow-hidden px-1.5 inline-flex items-center text-caption-regular font-sans rounded-full border-0.5 border-border-300 bg-bg-200 group-hover/tag:bg-accent-900 group-hover/tag:border-accent-100/60 stacks:group-hover/tag:bg-page stacks:group-hover/tag:layers-1-accent stacks:group-hover/tag:border-transparent"><span dir="auto" class="text-nowrap text-text-300 font-normal group-hover/tag:text-text-200 break-all truncate">motherduck</span></span><span class="transition-opacity opacity-[0%] group-hover/tag:opacity-[100%] h-[17px] absolute right-[0.5px] rounded-r-full flex items-center px-1.5 bg-gradient-to-r from-accent-900/0 via-accent-900/100 via-30% to-accent-900/100 [&amp;:where(:root[dir=rtl]_:dir(rtl))]:right-auto [&amp;:where(:root[dir=rtl]_:dir(rtl))]:left-[0.5px] [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-r-none [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-l-full [&amp;:where(:root[dir=rtl]_:dir(rtl))]:bg-gradient-to-l stacks:bg-page stacks:layers-1-accent stacks:[mask-image:linear-gradient(to_right,transparent,black_30%)] stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:layers-1-accent stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:[mask-image:linear-gradient(to_left,transparent,black_30%)]"><span data-cds="Icon" data-cds-mirror="" class="transition-[opacity,scale,transform] group-hover/tag:ease-out duration-[500ms] ease-in text-accent-100 group-hover/tag:scale-[100%] scale-[80%] group-hover/tag:opacity-[100%] opacity-[0%]" aria-hidden="true" style="font-size: calc(1rem * var(--cds-rem-scale, 1)); font-weight: 533.3;"></span></span></a></span></span></li>
<li><strong>Written tutorial: “dbt Tutorial: Build Your First Real Project, No Warehouse Needed”</strong> (Data Vidhya). It builds a full dbt Core and DuckDB project with seeds, staging views, mart tables, and tests, with no accounts or Docker. Good for the basics: <a class="underline [&amp;:where(:dir(rtl))]:after:content-['\200E']" href="https://datavidhya.com/blog/dbt-tutorial/">https://datavidhya.com/blog/dbt-tutorial/</a> <span data-not-prose=""><span class="inline-flex" id="base-ui-_r_33i_"><a href="https://datavidhya.com/blog/dbt-tutorial/" target="_blank" rel="noopener noreferrer" class="group/tag relative h-[18px] rounded-full inline-flex items-center overflow-hidden -translate-y-px cursor-pointer"><span class="relative transition-colors h-full max-w-[180px] overflow-hidden px-1.5 inline-flex items-center text-caption-regular font-sans rounded-full border-0.5 border-border-300 bg-bg-200 group-hover/tag:bg-accent-900 group-hover/tag:border-accent-100/60 stacks:group-hover/tag:bg-page stacks:group-hover/tag:layers-1-accent stacks:group-hover/tag:border-transparent"><span dir="auto" class="text-nowrap text-text-300 font-normal group-hover/tag:text-text-200 break-all truncate">datavidhya</span></span><span class="transition-opacity opacity-[0%] group-hover/tag:opacity-[100%] h-[17px] absolute right-[0.5px] rounded-r-full flex items-center px-1.5 bg-gradient-to-r from-accent-900/0 via-accent-900/100 via-30% to-accent-900/100 [&amp;:where(:root[dir=rtl]_:dir(rtl))]:right-auto [&amp;:where(:root[dir=rtl]_:dir(rtl))]:left-[0.5px] [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-r-none [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-l-full [&amp;:where(:root[dir=rtl]_:dir(rtl))]:bg-gradient-to-l stacks:bg-page stacks:layers-1-accent stacks:[mask-image:linear-gradient(to_right,transparent,black_30%)] stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:layers-1-accent stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:[mask-image:linear-gradient(to_left,transparent,black_30%)]"><span data-cds="Icon" data-cds-mirror="" class="transition-[opacity,scale,transform] group-hover/tag:ease-out duration-[500ms] ease-in text-accent-100 group-hover/tag:scale-[100%] scale-[80%] group-hover/tag:opacity-[100%] opacity-[0%]" aria-hidden="true" style="font-size: calc(1rem * var(--cds-rem-scale, 1)); font-weight: 533.3;"></span></span></a></span></span></li>
<li><strong>Olist + dbt + DuckDB on GitHub:</strong> a public <code dir="ltr">olist-dbt-duckdb</code> repo describes a SQL-only analytics project on the Olist data using dbt and DuckDB. Look at it <em>after</em> you build yours, to compare your choices. It’s on the profile github.com/simonnc. <span data-not-prose=""><span class="inline-flex" id="base-ui-_r_33m_"><a href="https://github.com/simonnc" target="_blank" rel="noopener noreferrer" class="group/tag relative h-[18px] rounded-full inline-flex items-center overflow-hidden -translate-y-px cursor-pointer"><span class="relative transition-colors h-full max-w-[180px] overflow-hidden px-1.5 inline-flex items-center text-caption-regular font-sans rounded-full border-0.5 border-border-300 bg-bg-200 group-hover/tag:bg-accent-900 group-hover/tag:border-accent-100/60 stacks:group-hover/tag:bg-page stacks:group-hover/tag:layers-1-accent stacks:group-hover/tag:border-transparent"><span dir="auto" class="text-nowrap text-text-300 font-normal group-hover/tag:text-text-200 break-all truncate">github</span></span><span class="transition-opacity opacity-[0%] group-hover/tag:opacity-[100%] h-[17px] absolute right-[0.5px] rounded-r-full flex items-center px-1.5 bg-gradient-to-r from-accent-900/0 via-accent-900/100 via-30% to-accent-900/100 [&amp;:where(:root[dir=rtl]_:dir(rtl))]:right-auto [&amp;:where(:root[dir=rtl]_:dir(rtl))]:left-[0.5px] [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-r-none [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-l-full [&amp;:where(:root[dir=rtl]_:dir(rtl))]:bg-gradient-to-l stacks:bg-page stacks:layers-1-accent stacks:[mask-image:linear-gradient(to_right,transparent,black_30%)] stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:layers-1-accent stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:[mask-image:linear-gradient(to_left,transparent,black_30%)]"><span data-cds="Icon" data-cds-mirror="" class="transition-[opacity,scale,transform] group-hover/tag:ease-out duration-[500ms] ease-in text-accent-100 group-hover/tag:scale-[100%] scale-[80%] group-hover/tag:opacity-[100%] opacity-[0%]" aria-hidden="true" style="font-size: calc(1rem * var(--cds-rem-scale, 1)); font-weight: 533.3;"></span></span></a></span></span></li>
<li><strong>A different stack for comparison:</strong> an Olist medallion project that uses PostgreSQL, dbt, Airflow, and Metabase in Docker. Useful for the star-schema design: <a class="underline [&amp;:where(:dir(rtl))]:after:content-['\200E']" href="https://github.com/DevonSLran/Data_Engineering-Final_Project">https://github.com/DevonSLran/Data_Engineering-Final_Project</a> <span data-not-prose=""><span class="inline-flex" id="base-ui-_r_33q_"><a href="https://github.com/DevonSLran/Data_Engineering-Final_Project" target="_blank" rel="noopener noreferrer" class="group/tag relative h-[18px] rounded-full inline-flex items-center overflow-hidden -translate-y-px cursor-pointer"><span class="relative transition-colors h-full max-w-[180px] overflow-hidden px-1.5 inline-flex items-center text-caption-regular font-sans rounded-full border-0.5 border-border-300 bg-bg-200 group-hover/tag:bg-accent-900 group-hover/tag:border-accent-100/60 stacks:group-hover/tag:bg-page stacks:group-hover/tag:layers-1-accent stacks:group-hover/tag:border-transparent"><span dir="auto" class="text-nowrap text-text-300 font-normal group-hover/tag:text-text-200 break-all truncate">github</span></span><span class="transition-opacity opacity-[0%] group-hover/tag:opacity-[100%] h-[17px] absolute right-[0.5px] rounded-r-full flex items-center px-1.5 bg-gradient-to-r from-accent-900/0 via-accent-900/100 via-30% to-accent-900/100 [&amp;:where(:root[dir=rtl]_:dir(rtl))]:right-auto [&amp;:where(:root[dir=rtl]_:dir(rtl))]:left-[0.5px] [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-r-none [&amp;:where(:root[dir=rtl]_:dir(rtl))]:rounded-l-full [&amp;:where(:root[dir=rtl]_:dir(rtl))]:bg-gradient-to-l stacks:bg-page stacks:layers-1-accent stacks:[mask-image:linear-gradient(to_right,transparent,black_30%)] stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:layers-1-accent stacks:[&amp;:where(:root[dir=rtl]_:dir(rtl))]:[mask-image:linear-gradient(to_left,transparent,black_30%)]"><span data-cds="Icon" data-cds-mirror="" class="transition-[opacity,scale,transform] group-hover/tag:ease-out duration-[500ms] ease-in text-accent-100 group-hover/tag:scale-[100%] scale-[80%] group-hover/tag:opacity-[100%] opacity-[0%]" aria-hidden="true" style="font-size: calc(1rem * var(--cds-rem-scale, 1)); font-weight: 533.3;"></span></span></a></span></span></li>
</ol>
<p dir="ltr">Use these to unblock yourself, but write your own models. Interviewers ask “why is this the grain?” and copied code won’t survive that question.</p>
<hr>
<h3 dir="ltr" aria-level="5">Common problems</h3>
<ul dir="ltr">
<li><strong>“Profile not found”:</strong> the name in <code dir="ltr">dbt_project.yml</code> must match <code dir="ltr">profiles.yml</code> exactly.</li>
<li><strong>“Could not set lock on file”:</strong> something else has <code dir="ltr">olist.duckdb</code> open. Close the DuckDB UI, CLI, or Streamlit app.</li>
<li><strong>Unique test fails on a key:</strong> inspect the duplicates with a quick <code dir="ltr">group by ... having count(*) &gt; 1</code> query before changing anything.</li>
<li><strong>Model not found with <code dir="ltr">ref()</code>:</strong> check the file name matches exactly, and that you ran <code dir="ltr">dbt deps</code> after editing <code dir="ltr">packages.yml</code>.</li>
</ul>
<p dir="ltr">When you’re stuck, paste the exact error and the model or YAML involved and I’ll debug it with you. I can also go deeper on any phase, for example the Streamlit app or the slim-CI setup.</p></div></div></div></div><div class="ms-[calc(var(--cds-assistant-message-text-inset,0px)_-_6px)] touch:has-[&gt;[data-size=xs]&gt;:first-child:not(time)]:ms-[calc(var(--cds-assistant-message-text-inset,0px)_-_0.625rem*var(--cds-rem-scale,1))] print:mt-xs"><div data-testid="message-actions" data-cds="MessageActions" data-deferred="" data-size="xs" class="flex items-center select-none"><span aria-hidden="true" class="h-control w-px"></span><button type="button" class="sr-only" aria-label="Show message actions for Claude responded: dbt + DuckDB Project: Step-by-Step (Olist E-commerce)"></button></div></div></div></div></div></div></div></div><div data-rs-index="14" data-index="14" data-testid="transcript-row" class="relative [@media(resolution:1dppx),(resolution:2dppx),(resolution:3dppx)]:[height:calc-size(auto,round(up,size,1px))]" data-cap-unmeasured="true" data-perf-row="human" data-perf-row-from-tail="10" data-perf-row-streaming="false" style="display: flow-root; position: relative; clip-path: inset(0px); contain: paint;" data-rs-ahead=""><div role="article" tabindex="-1" class="rounded-lg focus-visible:shadow-focus focus-visible:outline-hidden" aria-setsize="30" aria-posinset="15" aria-label="Message 15 of 30"><div class="contents" data-mini-claude-message="_r_1hr_"><div data-transcript-row="" class="mt-6 [&amp;&gt;[data-turn-key]]:!my-0 [&amp;&gt;[data-reply-scope]&gt;[data-turn-key]]:!my-0 [&amp;:has(&gt;[data-reserves-actions-gap]:not(:empty)):has(&gt;[data-reserves-actions-gap]:not(:empty),&gt;[data-reserves-actions-gap]&gt;*)]:pb-md [&amp;:has(&gt;[data-reply-scope]&gt;[data-reserves-actions-gap]:not(:empty)):has(&gt;[data-reply-scope]&gt;[data-reserves-actions-gap]:not(:empty),&gt;[data-reply-scope]&gt;[data-reserves-actions-gap]&gt;*)]:pb-md"><h3 data-find-o