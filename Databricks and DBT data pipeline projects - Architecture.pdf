length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-sql" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(204, 123, 244);">with</span> spine <span style="color: rgb(204, 123, 244);">as</span> (
</span><span>    {{ dbt_utils.date_spine(
</span><span>        datepart=<span style="color: rgb(155, 233, 99);">"day"</span>,
</span><span><span style="color: rgb(204, 123, 244);">        start_date</span>=<span style="color: rgb(155, 233, 99);">"cast('2016-01-01' as date)"</span>,
</span><span>        end_date=<span style="color: rgb(155, 233, 99);">"cast('2019-01-01' as date)"</span>) }}
</span><span>)
</span><span><span style="color: rgb(204, 123, 244);">select</span>
</span><span><span style="color: rgb(112, 184, 255);">    cast</span>(date_day <span style="color: rgb(204, 123, 244);">as date</span>)         <span style="color: rgb(204, 123, 244);">as</span> date_key,
</span><span>    extract(<span style="color: rgb(204, 123, 244);">year from</span> date_day)    <span style="color: rgb(204, 123, 244);">as year</span>,
</span><span>    extract(<span style="color: rgb(204, 123, 244);">month from</span> date_day)   <span style="color: rgb(204, 123, 244);">as month</span>,
</span><span>    strftime(date_day, <span style="color: rgb(155, 233, 99);">'%Y-%m'</span>)    <span style="color: rgb(204, 123, 244);">as</span> year_month,
</span><span>    dayname(date_day)              <span style="color: rgb(204, 123, 244);">as</span> day_name
</span><span><span style="color: rgb(204, 123, 244);">from</span> spine</span></span></span></code></pre></div></div></div>
<ol dir="ltr" start="4">
<li>Facts:</li>
</ol>
<p dir="ltr"><code dir="ltr">fct_order_items.sql</code> (grain: one row per order item). Select a surrogate key from <code dir="ltr">order_id</code> + <code dir="ltr">order_item_id</code>, <code dir="ltr">order_id</code>, <code dir="ltr">product_key</code>, <code dir="ltr">seller_key</code>, <code dir="ltr">price</code>, <code dir="ltr">freight_value</code>, <code dir="ltr">category_name</code>, and <code dir="ltr">cast(purchased_at as date) as purchase_date_key</code>.</p>
<p dir="ltr"><code dir="ltr">fct_orders.sql</code> is Phase 4, because it’s incremental.</p>
<p dir="ltr"><strong>Done when:</strong> <code dir="ltr">dbt run --select int_order_items_enriched int_orders_enriched dim_customers dim_sellers dim_products dim_date fct_order_items</code> passes.</p>
<h3 dir="ltr" aria-level="5">Phase 4: Incremental model and snapshot (1.5 hrs)</h3>
<h4 dir="ltr" aria-level="6">Incremental <code dir="ltr">fct_orders</code></h4>
<div data-not-prose=""><div role="group" aria-label="sql code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_32t_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">sql</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-sql" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span>{{ config(
</span><span>    materialized=<span style="color: rgb(155, 233, 99);">'incremental'</span>,
</span><span>    unique_key=<span style="color: rgb(155, 233, 99);">'order_id'</span>,
</span><span>    incremental_strategy=<span style="color: rgb(155, 233, 99);">'delete+insert'</span>
</span><span>) }}
</span><span>
</span><span><span style="color: rgb(204, 123, 244);">select</span>
</span><span>    order_id,
</span><span>    {{ dbt_utils.generate_surrogate_key(['customer_unique_id']) }} <span style="color: rgb(204, 123, 244);">as</span> customer_key,
</span><span><span style="color: rgb(112, 184, 255);">    cast</span>(purchased_at <span style="color: rgb(204, 123, 244);">as date</span>) <span style="color: rgb(204, 123, 244);">as</span> purchase_date_key,
</span><span>    order_status,
</span><span>    purchased_at, delivered_at, estimated_delivery_at,
</span><span>    payment_total, items_total, freight_total, item_count,
</span><span>    review_score, delivery_delay_days, is_late
</span><span><span style="color: rgb(204, 123, 244);">from</span> {{ ref(<span style="color: rgb(155, 233, 99);">'int_orders_enriched'</span>) }}
</span><span>
</span><span>{% <span style="color: rgb(204, 123, 244);">if</span> is_incremental<span style="color: rgb(211, 215, 222);">()</span> %}
</span><span><span style="color: rgb(204, 123, 244);">where</span> purchased_at &gt;= (<span style="color: rgb(204, 123, 244);">select</span><span style="color: rgb(112, 184, 255);"> max</span>(purchased_at) - interval <span style="color: rgb(94, 237, 237);">30</span><span style="color: rgb(204, 123, 244);"> day from</span> {{ this }})
</span><span>{% endif %}</span></span></span></code></pre></div></div></div>
<p dir="ltr">The 30-day lookback handles <strong>late-arriving updates</strong>. An order’s status can change after purchase, and filtering strictly on “newer than max” would miss that. Because of <code dir="ltr">unique_key</code>, reprocessed rows replace the old ones. This is a great interview talking point.</p>
<p dir="ltr" data-cds-heading=""><strong>Prove it works:</strong></p>
<ol dir="ltr">
<li><code dir="ltr">dbt run --select fct_orders</code> (first run builds everything).</li>
<li>Find a recent order and change its status:</li>
</ol>
<div data-not-prose=""><div role="group" aria-label="python code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-100"><div class="static opacity-0 transition-[position] transition-discrete duration-0 delay-300 group-hover/copy:sticky group-hover/copy:opacity-100 group-hover/copy:delay-0 group-focus-within/copy:sticky group-focus-within/copy:opacity-100 group-focus-within/copy:delay-0 pointer-coarse:sticky pointer-coarse:opacity-100 [@media(hover:none)]:sticky [@media(max-resolution:1.99dppx)]:sticky [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-text-button-icon-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md