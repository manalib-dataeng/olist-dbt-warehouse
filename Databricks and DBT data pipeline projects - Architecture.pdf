 pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_2vs_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow] stacks:transition-[box-shadow] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer  "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-size: calc(1.25rem * var(--cds-rem-scale, 1)); font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-secondary text-caption-regular font-sans p-3.5 pb-0 print:break-after-avoid" data-find-omitted="">python</div><div class="overflow-x-auto print:overflow-x-clip"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-[length:var(--msg-code-block-size,0.875rem)] !leading-relaxed p-3.5 print:!break-inside-auto print:overflow-clip" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-python" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(204, 123, 244);">import</span> duckdb
</span><span><span style="color: rgb(204, 123, 244);">import</span> streamlit <span style="color: rgb(204, 123, 244);">as</span> st
</span><span>
</span><span>DB_PATH = <span style="color: rgb(155, 233, 99);">"olist/olist.duckdb"</span>
</span><span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>set_page_config<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(247, 171, 95);">page_title</span>=<span style="color: rgb(155, 233, 99);">"Olist Analytics"</span><span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(247, 171, 95);"> layout</span>=<span style="color: rgb(155, 233, 99);">"wide"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>title<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Olist E-commerce Analytics"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>caption<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Built from the dbt marts: fct_order_items, fct_orders, dim_sellers"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>
</span><span>
</span><span><span style="color: rgb(211, 215, 222);">@</span><span style="color: rgb(112, 184, 255);">st</span><span style="color: rgb(211, 215, 222);">.</span><span style="color: rgb(112, 184, 255);">cache_data</span><span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(247, 171, 95);">ttl</span>=<span style="color: rgb(94, 237, 237);">300</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span><span style="color: rgb(204, 123, 244);">def</span><span style="color: rgb(112, 184, 255);"> run_query</span><span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(247, 171, 95);">sql</span><span style="color: rgb(211, 215, 222);">:</span><span style="color: rgb(251, 173, 96);"> str</span><span style="color: rgb(211, 215, 222);">):</span>
</span><span><span style="color: rgb(129, 136, 152);">    # Open the database only for the query, then close it,</span>
</span><span><span style="color: rgb(129, 136, 152);">    # so the app never blocks dbt from writing later.</span>
</span><span>    con = duckdb<span style="color: rgb(211, 215, 222);">.</span>connect<span style="color: rgb(211, 215, 222);">(</span>DB_PATH<span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(247, 171, 95);"> read_only</span>=<span style="color: rgb(94, 237, 237);">True</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span><span style="color: rgb(204, 123, 244);">    try</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span><span style="color: rgb(204, 123, 244);">        return</span> con<span style="color: rgb(211, 215, 222);">.</span>execute<span style="color: rgb(211, 215, 222);">(</span>sql<span style="color: rgb(211, 215, 222);">).</span>df<span style="color: rgb(211, 215, 222);">()</span>
</span><span><span style="color: rgb(204, 123, 244);">    finally</span><span style="color: rgb(211, 215, 222);">:</span>
</span><span>        con<span style="color: rgb(211, 215, 222);">.</span>close<span style="color: rgb(211, 215, 222);">()</span>
</span><span>
</span><span>
</span><span>MONTHLY_REVENUE = <span style="color: rgb(155, 233, 99);">"""</span>
</span><span><span style="color: rgb(155, 233, 99);">select strftime(purchase_date_key, '%Y-%m') as year_month,</span>
</span><span><span style="color: rgb(155, 233, 99);">       round(sum(price), 2) as revenue</span>
</span><span><span style="color: rgb(155, 233, 99);">from main.fct_order_items</span>
</span><span><span style="color: rgb(155, 233, 99);">where order_status &lt;&gt; 'canceled'</span>
</span><span><span style="color: rgb(155, 233, 99);">group by 1</span>
</span><span><span style="color: rgb(155, 233, 99);">order by 1</span>
</span><span><span style="color: rgb(155, 233, 99);">"""</span>
</span><span>
</span><span>LATE_BY_SELLER = <span style="color: rgb(155, 233, 99);">"""</span>
</span><span><span style="color: rgb(155, 233, 99);">select s.seller_id,</span>
</span></span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span><span style="color: rgb(155, 233, 99);">       count(distinct oi.order_id) as orders,</span>
</span><span><span style="color: rgb(155, 233, 99);">       round(count(distinct case when o.is_late = 1 then oi.order_id end) * 1.0</span>
</span><span><span style="color: rgb(155, 233, 99);">             / count(distinct oi.order_id), 3) as late_rate</span>
</span><span><span style="color: rgb(155, 233, 99);">from main.fct_order_items oi</span>
</span><span><span style="color: rgb(155, 233, 99);">join main.fct_orders o using (order_id)</span>
</span><span><span style="color: rgb(155, 233, 99);">join main.dim_sellers s using (seller_key)</span>
</span><span><span style="color: rgb(155, 233, 99);">where o.is_late is not null</span>
</span><span><span style="color: rgb(155, 233, 99);">group by 1</span>
</span><span><span style="color: rgb(155, 233, 99);">having count(distinct oi.order_id) &gt;= 30</span>
</span><span><span style="color: rgb(155, 233, 99);">order by late_rate desc</span>
</span><span><span style="color: rgb(155, 233, 99);">limit 20</span>
</span><span><span style="color: rgb(155, 233, 99);">"""</span>
</span><span>
</span><span>REPEAT_RATE = <span style="color: rgb(155, 233, 99);">"""</span>
</span><span><span style="color: rgb(155, 233, 99);">with c as (</span>
</span><span><span style="color: rgb(155, 233, 99);">    select customer_key, count(*) as n</span>
</span><span><span style="color: rgb(155, 233, 99);">    from main.fct_orders</span>
</span><span><span style="color: rgb(155, 233, 99);">    where order_status = 'delivered'</span>
</span><span><span style="color: rgb(155, 233, 99);">    group by 1</span>
</span><span><span style="color: rgb(155, 233, 99);">)</span>
</span><span><span style="color: rgb(155, 233, 99);">select round(avg(case when n &gt; 1 then 1.0 else 0 end), 4) as repeat_rate,</span>
</span><span><span style="color: rgb(155, 233, 99);">       count(*) as customers</span>
</span><span><span style="color: rgb(155, 233, 99);">from c</span>
</span><span><span style="color: rgb(155, 233, 99);">"""</span>
</span><span>
</span><span><span style="color: rgb(129, 136, 152);"># 1. Monthly revenue</span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>subheader<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Monthly revenue"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>revenue = run_query<span style="color: rgb(211, 215, 222);">(</span>MONTHLY_REVENUE<span style="color: rgb(211, 215, 222);">)</span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>line_chart<span style="color: rgb(211, 215, 222);">(</span>revenue<span style="color: rgb(211, 215, 222);">.</span>set_index<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"year_month"</span><span style="color: rgb(211, 215, 222);">))</span>
</span><span>
</span><span><span style="color: rgb(129, 136, 152);"># 2. Late delivery rate by seller</span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>subheader<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Late delivery rate by seller (sellers with 30+ orders)"</span><span style="color: rgb(211, 215, 222);">)</span>
</span></span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span><span>late = run_query<span style="color: rgb(211, 215, 222);">(</span>LATE_BY_SELLER<span style="color: rgb(211, 215, 222);">)</span>
</span><span>left<span style="color: rgb(211, 215, 222);">,</span> right = st<span style="color: rgb(211, 215, 222);">.</span>columns<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(94, 237, 237);">2</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span><span style="color: rgb(204, 123, 244);">with</span> left<span style="color: rgb(211, 215, 222);">:</span>
</span><span>    st<span style="color: rgb(211, 215, 222);">.</span>dataframe<span style="color: rgb(211, 215, 222);">(</span>late<span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(247, 171, 95);"> use_container_width</span>=<span style="color: rgb(94, 237, 237);">True</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span><span style="color: rgb(204, 123, 244);">with</span> right<span style="color: rgb(211, 215, 222);">:</span>
</span><span>    st<span style="color: rgb(211, 215, 222);">.</span>bar_chart<span style="color: rgb(211, 215, 222);">(</span>late<span style="color: rgb(211, 215, 222);">.</span>set_index<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"seller_id"</span><span style="color: rgb(211, 215, 222);">)[</span><span style="color: rgb(155, 233, 99);">"late_rate"</span><span style="color: rgb(211, 215, 222);">])</span>
</span><span>
</span><span><span style="color: rgb(129, 136, 152);"># 3. Repeat purchase rate</span>
</span><span>st<span style="color: rgb(211, 215, 222);">.</span>subheader<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Repeat purchase rate"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>repeat = run_query<span style="color: rgb(211, 215, 222);">(</span>REPEAT_RATE<span style="color: rgb(211, 215, 222);">)</span>
</span><span>rate = <span style="color: rgb(251, 173, 96);">float</span><span style="color: rgb(211, 215, 222);">(</span>repeat<span style="color: rgb(211, 215, 222);">[</span><span style="color: rgb(155, 233, 99);">"repeat_rate"</span><span style="color: rgb(211, 215, 222);">].</span>iloc<span style="color: rgb(211, 215, 222);">[</span><span style="color: rgb(94, 237, 237);">0</span><span style="color: rgb(211, 215, 222);">])</span>
</span><span>customers = <span style="color: rgb(251, 173, 96);">int</span><span style="color: rgb(211, 215, 222);">(</span>repeat<span style="color: rgb(211, 215, 222);">[</span><span style="color: rgb(155, 233, 99);">"customers"</span><span style="color: rgb(211, 215, 222);">].</span>iloc<span style="color: rgb(211, 215, 222);">[</span><span style="color: rgb(94, 237, 237);">0</span><span style="color: rgb(211, 215, 222);">])</span>
</span><span>c1<span style="color: rgb(211, 215, 222);">,</span> c2 = st<span style="color: rgb(211, 215, 222);">.</span>columns<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(94, 237, 237);">2</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>c1<span style="color: rgb(211, 215, 222);">.</span>metric<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Customers with 2+ delivered orders"</span><span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(204, 123, 244);"> f</span><span style="color: rgb(155, 233, 99);">"</span><span style="color: rgb(94, 237, 237);">{</span>rate<span style="color: rgb(204, 123, 244);">:.2%</span><span style="color: rgb(94, 237, 237);">}</span><span style="color: rgb(155, 233, 99);">"</span><span style="color: rgb(211, 215, 222);">)</span>
</span><span>c2<span style="color: rgb(211, 215, 222);">.</span>metric<span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(155, 233, 99);">"Customers with a delivered order"</span><span style="color: rgb(211, 215, 222);">,</span><span style="color: rgb(204, 123, 244);"> f</span><span style="color: rgb(155, 233, 99);">"</span><span style="color: rgb(94, 237, 237);">{</span>customers<span style="color: rgb(204, 123, 244);">:,</span><span style="color: rgb(94, 237, 237);">}</span><span style="color: rgb(155, 233, 99);">"</span><span style="color: rgb(211, 215, 222);">)</span></span></span></span></code></pre></div></div></div>
<p dir="ltr">The table names use the <code dir="ltr">main</code> schema, which is where dbt puts models by default with this setup.</p>
<h3 dir="ltr" aria-level="5">Step 3: Run it</h3>
<p dir="ltr">From the repo root, with the virtual environment active:</p>
